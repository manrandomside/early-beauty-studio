---
import { ADDRESS, HOURS, WA_TEXT, IG, MAPS } from "../data/site.js";
---
<section class="s visit-s" id="kunjungi">
  <div class="in visit">
    <div class="rv">
      <div class="s-head"><span class="eyebrow">Kunjungi studio</span><h2>Sampai jumpa <em>di Negara.</em></h2></div>
      <p class="ctas"><a class="btn dark" href={MAPS} target="_blank" rel="noopener">Buka Google Maps</a><a class="btn" style="color:var(--plum)" href={IG} target="_blank" rel="noopener">Instagram</a></p>
    </div>
    <div class="rv">
      <div class="facts">
        <div class="row"><span>Alamat</span><span>{ADDRESS}</span></div>
        <div class="row"><span>Jam buka</span><span>{HOURS}<small id="nowOpen"></small></span></div>
        <div class="row"><span>Booking</span><span>WhatsApp {WA_TEXT}</span></div>
        <div class="row"><span>Google</span><span>5.0 ★ dari 3 ulasan</span></div>
        <div class="row"><span>Galungan</span><span id="galungan">Rabu, 13 Januari 2027<small id="bookBy"></small></span></div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .visit { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  .facts { display: grid; gap: 4px; }
  .facts .row span:last-child { text-align: right; }
  @media (max-width: 820px) { .visit { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { formatDate, longDate } from "../data/site.js";
  import { isOpen, holyDays, DAY } from "../lib/bali.js";

  const $ = id => document.getElementById(id);
  $("nowOpen").textContent = isOpen() ? "Sedang buka" : "Sedang tutup, buka lagi 10.00";

  // the busiest weeks of the year; dates come from the 210-day Bali calendar, so they never go stale
  const { today, gal, bookBy } = holyDays();
  $("galungan").firstChild.textContent = `${longDate(gal)} · ${Math.round((gal - today) / DAY)} hari lagi`;
  $("bookBy").textContent = `Slot cepat penuh, booking sebelum ${formatDate(bookBy)}`;
</script>
