---
import { ADDRESS, HOURS, WA_TEXT, IG, MAPS, GEO, GOOGLE } from "../data/site.js";
// Google's plain embed needs no API key; the pin is the studio's coordinates
const map = `https://maps.google.com/maps?q=${GEO.join(",")}&z=16&output=embed`;
---
<section class="s visit-s" id="kunjungi">
  <div class="in visit">
    <div class="map rv">
      <iframe src={map} title="Peta lokasi Early Beauty Studio di Banyubiru, Negara" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    <div class="rv">
      <div class="s-head"><span class="eyebrow">Kunjungi studio</span><h2>Sampai jumpa <em>di Negara.</em></h2></div>
      <div class="facts">
        <div class="row"><span>Alamat</span><span>{ADDRESS}</span></div>
        <div class="row"><span>Jam buka</span><span>{HOURS}<small id="nowOpen"></small></span></div>
        <div class="row"><span>Booking</span><span>WhatsApp {WA_TEXT}</span></div>
        <div class="row"><span>Google</span><span>{GOOGLE.rating} ★ dari {GOOGLE.count} ulasan</span></div>
      </div>
      <p class="ctas visit-ctas"><a class="btn dark" href={MAPS} target="_blank" rel="noopener">Petunjuk arah</a><a class="btn" style="color:var(--plum)" href={IG} target="_blank" rel="noopener">Instagram</a></p>
    </div>
  </div>
</section>

<style is:global>
  .visit { display: grid; grid-template-columns: 1.1fr 1fr; gap: 48px; align-items: center; }
  .map { aspect-ratio: 4 / 3.4; background: var(--blush); }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; filter: saturate(.75) sepia(.12); }
  .visit-ctas { margin-top: 24px; }
  .facts { display: grid; gap: 4px; }
  .facts .row span:last-child { text-align: right; }
  @media (max-width: 820px) { .visit { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  import { isOpen } from "../lib/bali.js";

  const $ = id => document.getElementById(id);
  $("nowOpen").textContent = isOpen() ? "Sedang buka" : "Sedang tutup, buka lagi 10.00";
</script>
