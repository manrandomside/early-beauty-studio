---
import { langOf, tr, link } from "../i18n/index.js";
const lang = langOf(Astro.url), T = s => tr(lang, s);
import { Image } from "astro:assets";
import logoDark from "../assets/logo-dark.jpg";
import logoMark from "../assets/logo-mark-light.png";
import { ADDRESS, HOURS, WA_TEXT, IG } from "../data/site.js";
---
<footer class="foot">
  <Image class="foot-mark" src={logoDark} width={375} alt="" aria-hidden="true" />
  <div class="in foot-grid">
    <div class="foot-brand">
      <a class="brand" href={link(lang, "/")}><Image src={logoMark} width={84} alt="Logo Early Beauty Studio" />EARLY BEAUTY</a>
      <p>{T("Studio eyelash, nails, lash lift dan alis di Negara, Jembrana. Booking cukup lewat WhatsApp.")}</p>
      <a href={IG} target="_blank" rel="noopener">Instagram @earlybeauty.studio</a>
    </div>
    <div><h2 class="foot-h">{T("Layanan")}</h2><a href={link(lang, "/harga/#lash")}>Eyelash Extension</a><a href={link(lang, "/harga/#nails")}>Nails</a><a href={link(lang, "/harga/#alis")}>{T("Lash Lift & Alis")}</a><a href={link(lang, "/kelas/")}>{T("Kelas kecantikan")}</a></div>
    <div><h2 class="foot-h">{T("Jelajahi")}</h2><a href={link(lang, "/")}>{T("Beranda")}</a><a href={link(lang, "/galeri/")}>{T("Galeri")}</a><a href={link(lang, "/kunjungi/")}>{T("Kunjungi studio")}</a><button type="button" data-sheet>Booking</button></div>
    <div><h2 class="foot-h">{T("Kunjungi")}</h2><p>{ADDRESS}</p><p>{T(HOURS)}</p><p>WA {WA_TEXT}</p></div>
  </div>
  <div class="in"><div class="foot-bottom">© {new Date().getFullYear()} Early Beauty Studio · Negara, Jembrana, Bali</div></div>
</footer>

<style is:global>
  /* the logo sits faded behind the columns */
  .foot { position: relative; overflow: hidden; background: var(--plum); color: #bfaaa5; font-size: 15px; padding-block: 72px 30px; }
  .foot-mark { position: absolute; left: 50%; top: 50%; width: min(96vw, 760px); height: auto; transform: translate(-50%, -50%); opacity: .07; mix-blend-mode: lighten; pointer-events: none; }
  .foot-grid { position: relative; display: grid; grid-template-columns: 1.5fr repeat(3, 1fr); gap: 36px; }
  .foot-grid .foot-h { margin: 0 0 14px; font: 500 12px var(--f-body); letter-spacing: .24em; text-transform: uppercase; color: var(--gold-2); }
  .foot-grid a, .foot-grid button { display: block; padding: 5px 0; color: #e6d6d1; text-decoration: none; background: none; border: 0; font: inherit; text-align: left; transition: color .25s; }
  .foot-grid a:hover, .foot-grid button:hover { color: var(--gold-2); }
  .foot-grid p { margin: 0 0 6px; max-width: 34ch; }
  .foot-brand .brand { display: flex; align-items: center; gap: 10px; font: 13px var(--f-display); letter-spacing: .32em; margin-bottom: 10px; }
  .foot-brand .brand img { width: 42px; height: 42px; }
  .foot-bottom { position: relative; margin-top: 48px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.08); text-align: center; font-size: 13px; color: #9c8783; }
  @media (max-width: 820px) { .foot { padding-bottom: 100px; } .foot-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .foot-brand { grid-column: 1 / -1; } }
</style>
