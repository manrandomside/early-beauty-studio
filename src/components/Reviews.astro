---
import { GOOGLE, REVIEWS, MAPS, IG, INSTA_STATS, COURSES } from "../data/site.js";
// proof the studio is trusted, all from public numbers
const PROOF = [
  [GOOGLE.rating + " ★", `rating dari ${GOOGLE.count} ulasan Google`, MAPS],
  [INSTA_STATS.posts, "hasil kerja dipajang di Instagram", IG],
  [INSTA_STATS.followers, "pengikut Instagram yang mengikuti hasil kerjanya", IG],
  [String(COURSES.length), "program kelas untuk yang ingin buka usaha sendiri", "/kelas/"]
];
// the wall of quotes appears once REVIEWS has entries; until then the numbers and the ask show
---
<section class="s reviews">
  <div class="in">
    <div class="rev-top rv">
      <div class="s-head" style="margin:0"><span class="eyebrow">Kenapa Early Beauty</span><h2>Dipercaya di Negara, <em>dipajang tiap hari.</em></h2></div>
    </div>
    <div class="proof">
      {PROOF.map(([n, label, href]) => <a class="proof-item rv" href={href} target={href.startsWith("http") ? "_blank" : undefined} rel="noopener"><strong>{n}</strong><span>{label}</span></a>)}
    </div>
    {REVIEWS.length > 0 && (
      <div class="rev-wall">
        {REVIEWS.map(([name, text, source]) => <figure class="rev rv"><blockquote>“{text}”</blockquote><figcaption>{name} · {source}</figcaption></figure>)}
      </div>
    )}
    <p class="rev-ask rv">Ulasanmu membantu orang lain di Negara menemukan studio ini. <a class="btn dark" href={MAPS} target="_blank" rel="noopener">Tulis ulasan di Google</a></p>
  </div>
</section>

<style is:global>
  .rev-top { display: flex; justify-content: space-between; align-items: end; gap: 28px; flex-wrap: wrap; margin-bottom: 36px; }
  .proof { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-bottom: 36px; }
  .proof-item { display: grid; gap: 6px; align-content: start; padding: 22px 0 0; border-top: 1px solid var(--plum); text-decoration: none; }
  .proof-item strong { font: 400 clamp(36px, 5vw, 54px)/1 var(--f-display); color: var(--ink); }
  .proof-item span { font-size: 14px; color: var(--muted); max-width: 22ch; }
  .proof-item:hover span { color: var(--ink); }
  .rev-wall { columns: 3 260px; column-gap: 18px; margin-bottom: 36px; }
  .rev { break-inside: avoid; margin: 0 0 18px; padding: 22px; background: #fff; border: 1px solid var(--line); }
  .rev blockquote { margin: 0 0 14px; font: italic 400 20px/1.4 var(--f-accent); }
  .rev figcaption { font-size: 13px; color: var(--muted); }
  .rev-ask { display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); }
  @media (max-width: 820px) { .proof { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 16px; } }
</style>
