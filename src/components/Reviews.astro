---
import { GOOGLE, REVIEWS, MAPS } from "../data/site.js";
// the wall of quotes appears once REVIEWS has entries; until then only the rating and the ask show
---
<section class="s reviews">
  <div class="in">
    <div class="rev-top rv">
      <div class="s-head" style="margin:0"><span class="eyebrow">Kata pelanggan</span><h2>Sudah pernah ke sini? <em>Ceritakan.</em></h2></div>
      <div class="rev-score">
        <strong>{GOOGLE.rating}</strong>
        <span class="stars" aria-hidden="true">★★★★★</span>
        <span>dari {GOOGLE.count} ulasan Google</span>
      </div>
    </div>
    {REVIEWS.length > 0 && (
      <div class="rev-wall">
        {REVIEWS.map(([name, text, source]) => <figure class="rev rv"><blockquote>“{text}”</blockquote><figcaption>{name} · {source}</figcaption></figure>)}
      </div>
    )}
    <p class="rev-ask rv">Ulasanmu membantu orang lain di Negara menemukan studio ini. <a class="btn dark" href={MAPS} target="_blank" rel="noopener">Tulis ulasan di Google</a></p>
  </div>
</section>

<style is:global>
  .rev-top { display: flex; justify-content: space-between; align-items: end; gap: 28px; flex-wrap: wrap; margin-bottom: 36px; }
  .rev-score { display: grid; justify-items: end; gap: 2px; text-align: right; color: var(--muted); font-size: 14px; }
  .rev-score strong { font: 400 64px/1 var(--f-display); color: var(--ink); }
  .rev-score .stars { color: var(--gold); letter-spacing: .2em; font-size: 18px; }
  .rev-wall { columns: 3 260px; column-gap: 18px; margin-bottom: 36px; }
  .rev { break-inside: avoid; margin: 0 0 18px; padding: 22px; background: #fff; border: 1px solid var(--line); }
  .rev blockquote { margin: 0 0 14px; font: italic 400 20px/1.4 var(--f-accent); }
  .rev figcaption { font-size: 13px; color: var(--muted); }
  .rev-ask { display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; padding: 22px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); }
  @media (max-width: 820px) { .rev-score { justify-items: start; text-align: left; } }
</style>
