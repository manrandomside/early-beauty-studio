---
import { Image } from "astro:assets";
import { LASH, BASES, COURSES } from "../data/site.js";
import { photo } from "../data/photos.js";

const k = n => Math.round(n / 1000) + "K";
const min = list => Math.min(...list);
// one card per page section, each starting price read from the price data
const CARDS = [
  ["Eyelash Extension", `Mulai ${k(min(LASH.map(l => l[1])))}`, "7 gaya, dari natural sampai anime", "/harga/#lash", "e1", "50% 45%"],
  ["Nails", `Mulai ${k(min(BASES.map(b => b[1])))} per jari`, "Hitung harga di nota nails", "/harga/#nails", "n4", "50% 50%"],
  ["Lash Lift & Alis", "40K–70K", "Lentik dan rapi tanpa extension", "/harga/#alis", "b2", "50% 85%"],
  ["Kelas kecantikan", `Mulai ${k(min(COURSES.map(c => c.price[0])))}`, `${COURSES.length} program, nail art dan eyelash`, "/kelas/", "s1", "50% 50%"]
];
---
<section class="s">
  <div class="in">
    <div class="s-head rv"><span class="eyebrow">Layanan</span><h2>Pilih yang kamu mau, <em>lihat harganya.</em></h2></div>
    <div class="svc-grid">
      {CARDS.map(([name, price, line, href, key, pos]) => (
        <a class="svc rv" href={href}>
          <span class="svc-img"><Image src={photo(key)} widths={[320, 600]} sizes="(max-width: 820px) 46vw, 270px" alt="" style={`object-position:${pos}`} /></span>
          <span class="svc-name">{name}</span>
          <span class="svc-price">{price}</span>
          <span class="svc-line">{line} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .svc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 22px; }
  .svc { display: grid; gap: 6px; text-decoration: none; }
  .svc-img { display: block; aspect-ratio: 4 / 5; overflow: hidden; margin-bottom: 8px; }
  .svc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
  .svc:hover .svc-img img { transform: scale(1.04); }
  .svc-name { font: 400 22px/1.2 var(--f-display); }
  .svc-price { font: italic 400 20px var(--f-accent); color: var(--mauve); }
  .svc-line { font-size: 14px; color: var(--muted); }
  .svc:hover .svc-line { color: var(--ink); }
  @media (max-width: 820px) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 14px; } .svc-name { font-size: 18px; } }
</style>
