---
import { Image } from "astro:assets";
import { LASH, BASES, COURSES } from "../data/site.js";
import { photo } from "../data/photos.js";

const k = n => Math.round(n / 1000) + "K";
const min = list => Math.min(...list);
// one door per need: each panel opens the page (or tab) that answers it; starting prices come from the price data
const PANELS = [
  ["Eyelash", `Mulai ${k(min(LASH.map(l => l[1])))}`, "7 gaya, dari natural sampai anime.", "Lihat gaya & harga", "/harga/#lash", "e1", "50% 45%"],
  ["Nails", `Mulai ${k(min(BASES.map(b => b[1])))} per jari`, "Hitung sendiri, kirim notanya ke WhatsApp.", "Hitung harga nails", "/harga/#nails", "n1", "50% 50%"],
  ["Alis", "40K–70K", "Lash lift, threading, dan brow lamination.", "Lihat harga alis", "/harga/#alis", "b4", "50% 85%"],
  ["Kelas", `Mulai ${k(min(COURSES.map(c => c.price[0])))}`, `${COURSES.length} program, alatnya bisa dibawa pulang.`, "Lihat kelas", "/kelas/", "s1", "50% 50%"]
];
---
<section class="s doors">
  <div class="in">
    <div class="s-head rv"><span class="eyebrow">Mau apa hari ini?</span><h2>Pilih layanannya, <em>sisanya kami bantu.</em></h2></div>
    <div class="door-grid">
      {PANELS.map(([word, price, line, cta, href, key, pos]) => (
        <a class="door rv" href={href}>
          <Image src={photo(key)} widths={[480, 800, 1100]} sizes="(max-width: 820px) 92vw, 540px" alt="" style={`object-position:${pos}`} />
          <span class="door-body">
            <span class="door-word">{word}</span>
            <span class="door-price">{price}</span>
            <span class="door-line">{line}</span>
            <span class="door-cta">{cta} →</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .door-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .door { position: relative; display: grid; align-items: end; aspect-ratio: 5 / 4; overflow: hidden; color: #f4e9e6; text-decoration: none; isolation: isolate; }
  .door img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.1s var(--ease); }
  .door::before { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(29,20,22,.05) 25%, rgba(29,20,22,.82) 100%); }
  .door:hover img { transform: scale(1.05); }
  .door-body { display: grid; gap: 4px; padding: clamp(20px, 3vw, 32px); }
  .door-word { font: 400 clamp(38px, 6vw, 64px)/1 var(--f-display); letter-spacing: .14em; text-transform: uppercase; }
  .door-price { font: italic 400 22px var(--f-accent); color: var(--gold-2); }
  .door-line { font-size: 15px; color: #e6d6d1; max-width: 34ch; }
  .door-cta { justify-self: start; margin-top: 12px; padding: 11px 18px; border: 1px solid rgba(227,200,143,.7); font: 500 11px var(--f-body); letter-spacing: .22em; text-transform: uppercase; color: var(--gold-2); transition: background .3s, color .3s; }
  .door:hover .door-cta { background: var(--gold); color: var(--plum); }
  @media (max-width: 820px) { .door-grid { grid-template-columns: minmax(0, 1fr); } .door { aspect-ratio: 4 / 3.6; } }
</style>
