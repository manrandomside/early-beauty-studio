<section class="s busy">
  <div class="in">
    <div class="s-head rv"><span class="eyebrow">Kalender hari raya</span><h2>Mau cantik saat <em>Galungan?</em></h2><p class="lead">Minggu menjelang Galungan dan Kuningan adalah waktu paling ramai di studio. Tanggalnya dihitung otomatis dari kalender Bali, jadi selalu terbaru.</p></div>
    <div class="days" id="days">
      <div class="day rv"><span class="k">Galungan</span><span class="n" id="gDays">–<small>hari</small></span><span class="d" id="gDate"></span></div>
      <div class="day rv"><span class="k">Kuningan</span><span class="n" id="kDays">–<small>hari</small></span><span class="d" id="kDate"></span></div>
      <div class="day rv"><span class="k">Saran booking</span><span class="n" id="bookBy" style="font-size:40px">–</span><span class="d">Paling lambat, supaya slot masih ada.</span></div>
    </div>
    <div class="bar"><i id="barFill"></i></div>
    <div class="bar-l"><span>Galungan lalu</span><span>Hari ini</span><span>Galungan berikutnya</span></div>
  </div>
</section>

<style is:global>
  .busy { background: var(--plum); color: #f1e4e0; overflow: hidden; position: relative; }
  .busy .s-head .eyebrow { color: var(--gold-2); }
  .busy h2 em { color: var(--gold-2); }
  .busy .lead { color: #cdb8b3; }
  .days { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .day { border: 1px solid rgba(201,164,95,.4); padding: 26px; display: grid; gap: 6px; background: rgba(255,255,255,.02); }
  .day .k { font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--gold); }
  .day .n { font: 400 58px/1 var(--f-display); color: #fff; }
  .day .n small { font: italic 22px var(--f-accent); color: var(--gold-2); margin-left: 6px; }
  .day .d { color: #cdb8b3; font-size: 14px; }
  .bar { margin-top: 26px; height: 6px; background: rgba(255,255,255,.08); position: relative; }
  .bar i { position: absolute; top: 0; bottom: 0; background: linear-gradient(90deg, var(--rose), var(--gold)); }
  .bar-l { display: flex; justify-content: space-between; font-size: 12px; color: #a99592; margin-top: 8px; letter-spacing: .08em; }
</style>

<script>
  import { formatDate, longDate } from "../data/site.js";
  import { holyDays, DAY } from "../lib/bali.js";
  import { onceVisible } from "../scripts/motion.js";

  const $ = id => document.getElementById(id);
  const { today, gal, prev, kun, bookBy } = holyDays();
  const dg = Math.round((gal - today) / DAY), dk = Math.round((kun - today) / DAY);
  $("gDate").textContent = longDate(gal);
  $("kDate").textContent = longDate(kun);
  $("bookBy").textContent = formatDate(bookBy, { month: "short" });
  $("barFill").style.width = ((today - prev) / (gal - prev) * 100).toFixed(1) + "%";

  // day counters tick up the first time they are seen
  const tickUp = (el, to) => {
    const t0 = performance.now();
    const f = now => { const p = Math.min(1, (now - t0) / 1200); el.firstChild.textContent = Math.round(to * (1 - Math.pow(1 - p, 4))); if (p < 1) requestAnimationFrame(f); };
    requestAnimationFrame(f);
  };
  onceVisible($("days"), () => { tickUp($("gDays"), dg); tickUp($("kDays"), dk); });
</script>
