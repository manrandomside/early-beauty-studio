---
import { SERVICES, TIMES } from "../data/site.js";
---
<div class="dock" id="dock"><a class="btn line" href="#nails">Hitung nails</a><button type="button" class="btn dark" data-sheet>Booking</button></div>

<div class="sheet-bg" id="sheetBg"></div>
<div class="sheet" id="sheet" data-lenis-prevent role="dialog" aria-modal="true" aria-labelledby="sheetTitle" aria-hidden="true" inert>
  <div class="grab"></div>
  <div class="sheet-top"><h3 id="sheetTitle">Booking</h3><button type="button" id="sheetClose" aria-label="Tutup">×</button></div>
  <p class="lead">Pilih layanan dan waktu yang kamu mau. Pesan WhatsApp-nya kami siapkan.</p>
  <div class="chips" id="svc">{SERVICES.map((s, i) => <button type="button" style={`--i:${i}`} data-s={s}>{s}</button>)}</div>
  <div class="when2"><label for="date2">Tanggal<input type="date" id="date2" /></label><label for="time2">Jam<select id="time2">{TIMES.map(t => <option>{t}</option>)}</select></label></div>
  <a class="btn dark" id="sheetSend" target="_blank" rel="noopener">Kirim ke WhatsApp</a>
</div>

<style is:global>
  /* sticky action bar on phones, shown once the hero is scrolled past */
  .dock { position: fixed; left: 0; right: 0; bottom: 0; z-index: 30; display: none; gap: 8px; padding: 10px max(12px, env(safe-area-inset-right, 0px)) calc(10px + env(safe-area-inset-bottom, 0px)) max(12px, env(safe-area-inset-left, 0px)); background: rgba(251,247,245,.92); backdrop-filter: blur(10px); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform .4s ease; }
  .dock.show { transform: none; }
  .dock .btn { flex: 1; padding: 14px 8px; }
  .dock .btn.line { color: var(--plum); }

  /* booking bottom sheet */
  .sheet-bg { position: fixed; inset: 0; z-index: 60; background: rgba(29,20,22,.55); opacity: 0; pointer-events: none; transition: opacity .35s; }
  .sheet-bg.open { opacity: 1; pointer-events: auto; }
  .sheet { position: fixed; left: 0; right: 0; bottom: 0; z-index: 61; max-width: 560px; margin: 0 auto; max-height: 90svh; overflow: auto; background: var(--porcelain); border-radius: 22px 22px 0 0;
    padding: 14px max(22px, env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) max(22px, env(safe-area-inset-left, 0px));
    transform: translateY(105%); transition: transform .55s var(--ease); display: grid; gap: 18px; }
  .sheet.open { transform: none; }
  .sheet .grab { width: 44px; height: 4px; border-radius: 9px; background: var(--line); justify-self: center; }
  .sheet-top { display: flex; justify-content: space-between; align-items: center; }
  .sheet-top h3 { margin: 0; font: 400 30px var(--f-display); }
  .sheet-top button { border: 0; background: none; font-size: 28px; line-height: 1; padding: 4px 8px; }
  .sheet .chips button { opacity: 0; }
  .sheet.open .chips button { animation: fadeUp .45s var(--ease) both; animation-delay: calc(.12s + var(--i) * .06s); }
  .sheet .when2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .sheet label { display: grid; gap: 6px; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); }
  .sheet input, .sheet select { font: 15px var(--f-body); padding: 10px; border: 1px solid var(--line); background: #fff; color: var(--ink); width: 100%; }
  @media (max-width: 820px) { .dock { display: flex; } }
  @media (prefers-reduced-motion: reduce) { .sheet .chips button { opacity: 1; } }
</style>

<script>
  import { waLink, longDate } from "../data/site.js";
  import { holyDays, DAY } from "../lib/bali.js";

  const $ = id => document.getElementById(id);
  const sheet = $("sheet"), bg = $("sheetBg"), chosen = new Set(["Eyelash Extension"]);
  // bookings start today (Bali time); the picker greys out past days and defaults to tomorrow
  const isoDay = t => new Date(t).toISOString().slice(0, 10), { today } = holyDays();
  $("date2").min = isoDay(today);
  $("date2").value = isoDay(today + DAY);

  function render() {
    $("svc").querySelectorAll("button").forEach(b => b.setAttribute("aria-pressed", String(chosen.has(b.dataset.s))));
    if ($("date2").value && $("date2").value < $("date2").min) $("date2").value = $("date2").min;
    const d = $("date2").value ? longDate(Date.parse($("date2").value + "T00:00:00Z")) : "-";
    $("sheetSend").href = waLink(`Halo kak Early Beauty, saya mau booking:\n- Layanan: ${[...chosen].join(", ") || "-"}\n- Tanggal: ${d}\n- Jam: ${$("time2").value} WITA\nApakah slotnya masih ada?`);
  }
  $("svc").addEventListener("click", e => { const b = e.target.closest("button"); if (!b) return; chosen.has(b.dataset.s) ? chosen.delete(b.dataset.s) : chosen.add(b.dataset.s); render(); });
  $("date2").onchange = $("time2").onchange = render;

  const open = on => { sheet.classList.toggle("open", on); bg.classList.toggle("open", on); sheet.setAttribute("aria-hidden", String(!on)); sheet.inert = !on; if (on) $("sheetClose").focus(); };
  document.querySelectorAll("[data-sheet]").forEach(b => b.addEventListener("click", () => open(true)));
  $("sheetClose").onclick = bg.onclick = () => open(false);
  addEventListener("keydown", e => e.key === "Escape" && open(false));
  render();

  new IntersectionObserver(([e]) => $("dock").classList.toggle("show", !e.isIntersecting)).observe(document.querySelector(".hero"));
</script>
