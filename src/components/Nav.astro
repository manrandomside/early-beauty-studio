---
import { Image } from "astro:assets";
import logoMark from "../assets/logo-mark-light.png";
import { PAGES } from "../data/site.js";
const { path = "/" } = Astro.props;
---
<nav class="nav" aria-label="Menu utama">
  <a class="brand" href="/"><Image src={logoMark} width={84} alt="Logo Early Beauty" loading="eager" />EARLY BEAUTY</a>
  <div class="nav-right">
    <div class="links">{PAGES.map(([label, href]) => <a href={href} aria-current={href === path ? "page" : undefined}>{label}</a>)}</div>
    <button type="button" class="nav-book" data-sheet>Booking</button>
    <button type="button" class="nav-menu" aria-expanded="false" aria-controls="menu">Menu</button>
  </div>
</nav>

<!-- phones: the page links open as a full-screen list -->
<div class="menu" id="menu" data-lenis-prevent hidden>
  <a href="/" aria-current={path === "/" ? "page" : undefined}>Beranda</a>
  {PAGES.map(([label, href]) => <a href={href} aria-current={href === path ? "page" : undefined}>{label}</a>)}
</div>

<style is:global>
  .nav { display: flex; justify-content: space-between; align-items: center; padding-block: 16px; padding-top: max(16px, env(safe-area-inset-top, 0px)); position: relative; z-index: 41; }
  .nav .brand { display: flex; align-items: center; gap: 10px; font: 13px var(--f-display); letter-spacing: .32em; text-decoration: none; }
  .nav .brand img { width: 40px; height: 40px; }
  .nav .links { display: flex; gap: 22px; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; }
  .nav .links a { text-decoration: none; opacity: .8; padding-bottom: 4px; }
  .nav .links a:hover, .nav .links a[aria-current] { opacity: 1; color: var(--gold-2); }
  .nav .links a[aria-current] { box-shadow: inset 0 -1px var(--gold); }
  .nav-right { display: flex; align-items: center; gap: 26px; }
  .nav-book, .nav-menu { border: 1px solid rgba(201,164,95,.6); background: none; padding: 9px 16px; font: 500 11px var(--f-body); letter-spacing: .22em; text-transform: uppercase; color: var(--gold-2); transition: background .3s, color .3s; }
  .nav-book:hover, .nav-menu:hover { background: var(--gold); color: var(--plum); }
  .nav-menu { display: none; }

  .menu { position: fixed; inset: 0; z-index: 40; background: var(--plum); display: grid; align-content: center; gap: 6px; padding: 96px max(28px, env(safe-area-inset-left, 0px)) 40px; }
  .menu[hidden] { display: none; }
  .menu a { font: 400 clamp(34px, 10vw, 48px)/1.25 var(--f-display); color: #f4e9e6; text-decoration: none; opacity: 0; animation: fadeUp .5s var(--ease) forwards; }
  .menu a:nth-child(2) { animation-delay: .05s; } .menu a:nth-child(3) { animation-delay: .1s; } .menu a:nth-child(4) { animation-delay: .15s; } .menu a:nth-child(5) { animation-delay: .2s; }
  .menu a[aria-current] { color: var(--gold-2); font-style: italic; }
  body.menu-open { overflow: hidden; }
  body.menu-open .hero { z-index: 45; }
  body.menu-open .nav { position: fixed; inset: 0 0 auto; padding-inline: max(18px, env(safe-area-inset-left, 0px)); color: #f4e9e6; }

  @media (max-width: 820px) {
    .nav .links { display: none; }
    .nav-right { gap: 8px; }
    .nav-menu { display: inline-block; }
  }
  /* small phones: Booking lives in the bottom dock, so the brand keeps one line */
  @media (max-width: 480px) { .nav-book { display: none; } }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>(".nav-menu")!, menu = document.getElementById("menu")!;
  const set = (on: boolean) => { menu.hidden = !on; btn.setAttribute("aria-expanded", String(on)); btn.textContent = on ? "Tutup" : "Menu"; document.body.classList.toggle("menu-open", on); };
  btn.addEventListener("click", () => set(menu.hidden));
  addEventListener("keydown", e => e.key === "Escape" && !menu.hidden && set(false));
</script>
