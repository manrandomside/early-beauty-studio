---
import { langOf, tr, link } from "../i18n/index.js";
const lang = langOf(Astro.url), T = s => tr(lang, s);
import { Image } from "astro:assets";
import logoDark from "../assets/logo-dark.jpg";
import { photo } from "../data/photos.js";
const WORDS = ["ujung kuku.", "helai bulu mata.", "lengkung alis."].map(T);
// one photo per word, in the same order; brow photos are before/after, so show the lower "after" half
const SHOTS = [["n1", "50% 50%"], ["e1", "50% 45%"], ["b4", "50% 85%"]];
---
<!-- the logo intro plays once per visit; coming back to the home page shows the hero straight away -->
<script is:inline>try { if (sessionStorage.getItem("intro") || matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("quick"); sessionStorage.setItem("intro", "1"); } catch {}</script>
<div id="intro" aria-hidden="true"><div class="mark"><Image src={logoDark} width={300} alt="" loading="eager" /></div></div>

<header class="hero" id="top">
  <div class="hf-photos" aria-hidden="true">
    {SHOTS.map(([key, pos], i) => <Image class:list={["hp", { on: i === 0 }]} src={photo(key)} widths={[480, 800, 1200, 1600, 2000]} sizes="100vw" style={`object-position:${pos}`} alt="" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "low"} />)}
  </div>
  <div class="in">
    <div class="hero-frame">
      <span class="hc tl"></span><span class="hc tr"></span><span class="hc bl"></span><span class="hc br"></span>
      <div class="hf-top fade" style="animation-delay:2.1s">Eyelash · Nails · Brow</div>
      <h1><span class="l"><span>{T("Cantik sampai ke")}</span></span><span class="l"><span class="rot" id="rot">{WORDS.map((w, i) => <em class:list={["w", { on: i === 0 }]} aria-hidden={i > 0 ? "true" : undefined}>{w}</em>)}</span></span></h1>
      <div class="hf-rule fade" style="animation-delay:2.3s"></div>
      <div class="hf-links fade" style="animation-delay:2.4s"><a href={link(lang, "/harga/#nails")}>{T("Hitung harga nails")}</a><a href={link(lang, "/harga/#lash")}>{T("Pilih gaya bulu mata")}</a></div>
    </div>
  </div>
</header>

<style is:global>
  /* intro: the logo opens from the middle, then a gold shine passes over it */
  #intro { position: fixed; inset: 0; z-index: 50; background: var(--plum); display: grid; place-items: center; animation: introOut .6s ease 1.5s forwards; }
  #intro .mark { width: min(56vw, 300px); aspect-ratio: 1; position: relative; overflow: hidden; }
  #intro img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: lighten; clip-path: inset(50% 50% 50% 50%); animation: reveal 1s cubic-bezier(.7,0,.2,1) .1s forwards; }
  #intro .mark::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgba(227,200,143,.55) 50%, transparent 65%); transform: translateX(-120%); animation: shine .9s ease .8s forwards; mix-blend-mode: screen; }
  @keyframes reveal { to { clip-path: inset(0 0 0 0); } }
  @keyframes shine { to { transform: translateX(120%); } }
  @keyframes introOut { to { opacity: 0; visibility: hidden; transform: scale(1.04); } }
  .quick #intro { display: none; }
  .quick .hero .fade { animation-delay: .5s !important; }
  .quick .hero-frame { animation-delay: 0s; }
  .quick .rot { animation-delay: .55s; }


  /* the logo's square frame opens up and becomes the hero */
  .hero-frame { position: relative; margin-block: 5vh 56px; padding: clamp(56px, 10vw, 110px) clamp(18px, 5vw, 64px); display: grid; justify-items: center; gap: 26px; text-align: center;
    border: 1px solid rgba(201,164,95,.5);
    animation: frameIn 1.2s cubic-bezier(.7,0,.2,1) 1.3s both; }
  @keyframes frameIn { from { clip-path: inset(50% 50% 50% 50%); } to { clip-path: inset(-20px); } }
  /* full-bleed photo behind the whole hero, the frame floats over it; the next photo is wiped in from the left,
     the same way the word is written, while the visible one zooms out slowly so the still photo feels alive */
  .hf-photos { position: absolute; inset: 0; z-index: -2; overflow: hidden; }
  .hf-photos::after { content: ""; position: absolute; inset: 0; z-index: 3;
    background: radial-gradient(ellipse 60% 45% at 50% 50%, rgba(29,20,22,.45), transparent 75%),
                linear-gradient(180deg, rgba(29,20,22,.82) 0%, rgba(29,20,22,.5) 30%, rgba(29,20,22,.55) 70%, var(--plum) 100%); }
  .hp { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; clip-path: inset(0 100% 0 0); transform: scale(1.1); }
  .hp.on { clip-path: inset(0); z-index: 1; animation: kenburns 8s linear forwards; }
  .hp.in { z-index: 2; transition: clip-path 1.1s var(--ease); }
  @keyframes kenburns { from { transform: scale(1.1); } to { transform: scale(1); } }
  .hc { position: absolute; width: 28px; height: 28px; border: 1.5px solid var(--gold); }
  .tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; }
  .tr { top: -2px; right: -2px; border-left: 0; border-bottom: 0; }
  .bl { bottom: -2px; left: -2px; border-right: 0; border-top: 0; }
  .br { bottom: -2px; right: -2px; border-left: 0; border-top: 0; }
  .hf-top { font: 400 13px var(--f-display); letter-spacing: .5em; text-transform: uppercase; color: var(--gold-2); padding-left: .5em; }
  .hf-rule { width: 90px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .hf-links { display: flex; gap: 14px 34px; flex-wrap: wrap; justify-content: center; }
  .hf-links a { font: 500 12px var(--f-body); letter-spacing: .24em; text-transform: uppercase; text-decoration: none; padding-bottom: 8px; color: #f4e9e6;
    background: linear-gradient(var(--gold), var(--gold)) center bottom / 28% 1px no-repeat; transition: background-size .45s ease, color .3s; }
  .hf-links a:hover { background-size: 100% 1px; color: var(--gold-2); }

  .hero h1 { margin: 0; font: 400 clamp(34px, 7.4vw, 76px)/1 var(--f-display); letter-spacing: .02em; text-wrap: balance; }
  .hero h1 .l { display: block; }
  /* line 1: letters rise out of a blur, one after another */
  .ch { display: inline-block; white-space: pre; opacity: 0; filter: blur(12px); transform: translateY(.35em); animation: chIn .8s var(--ease) forwards; }
  @keyframes chIn { to { opacity: 1; filter: blur(0); transform: none; } }
  /* line 2: the italic is written in from left to right, then rewritten every few seconds */
  /* all words share one grid cell, so the line keeps the size of the longest word and nothing below jumps */
  .rot { display: inline-grid; animation: wipe 1.1s var(--ease) 2.25s both; }
  @keyframes wipe { from { clip-path: inset(-30% 100% -30% 0); } to { clip-path: inset(-30% -6% -30% 0); } }
  .hero h1 em { font: italic 400 min(1.62em, 11.5vw)/1.05 var(--f-accent); color: var(--gold-2); white-space: nowrap; }
  .rot .w { grid-area: 1 / 1; clip-path: inset(-30% 100% -30% 0); transition: clip-path .6s var(--ease); }
  .rot .w.on { clip-path: inset(-30% -6% -30% 0); }
  .rot .w.out { clip-path: inset(-30% -6% -30% 100%); }
  .rot .w.reset { transition: none; }

  @media (max-width: 820px) {
    .hf-top { font-size: 11px; letter-spacing: .3em; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch { opacity: 1; filter: none; transform: none; }
  }
</style>

<script>
  import { REDUCE } from "../scripts/motion.js";

  const quick = document.documentElement.classList.contains("quick");
  setTimeout(() => document.getElementById("intro")?.remove(), quick ? 0 : 2200);

  // line 1: split into letters for the blur-rise, keeping words unbreakable
  const line = document.querySelector(".hero h1 .l > span");
  let ci = 0;
  line.innerHTML = `<span class="sr-only">${line.textContent}</span>` + line.textContent.split(" ").map(w => `<span style="white-space:nowrap" aria-hidden="true">${[...w].map(c => `<span class="ch" style="animation-delay:${((quick ? .1 : 1.7) + ci++ * .045).toFixed(3)}s">${c}</span>`).join("")}</span>`).join(" ");

  // line 2: the current word is wiped out to the right, the next one is written in from the left
  // the photo behind changes together with the word
  const words = [...document.querySelectorAll("#rot .w")], shots = [...document.querySelectorAll(".hp")];
  let wi = 0;
  if (!REDUCE) setTimeout(() => setInterval(() => {
    const cur = words[wi], curShot = shots[wi], next = words[wi = (wi + 1) % words.length], nextShot = shots[wi];
    cur.classList.replace("on", "out");
    setTimeout(() => {
      next.classList.add("on");
      nextShot.classList.add("in"); void nextShot.offsetWidth; nextShot.classList.add("on");
    }, 450);
    setTimeout(() => { curShot.classList.remove("on"); nextShot.classList.remove("in"); }, 1600);
    setTimeout(() => { cur.classList.add("reset"); cur.classList.remove("out"); void cur.offsetWidth; cur.classList.remove("reset"); }, 1100);
  }, 3600), quick ? 600 : 2200);
</script>
