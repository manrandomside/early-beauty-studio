---
import { Image } from "astro:assets";
import logoDark from "../assets/logo-dark.jpg";
import { RIBBON } from "../data/site.js";
---
<div id="intro" aria-hidden="true"><div class="mark"><Image src={logoDark} width={300} alt="" loading="eager" /></div></div>

<header class="hero" id="top">
  <canvas id="dust" aria-hidden="true"></canvas>
  <Image class="ghost" src={logoDark} width={375} alt="" aria-hidden="true" loading="eager" />
  <div class="glow"></div>
  <div class="in">
    <nav class="nav">
      <a class="brand" href="#top"><Image src={logoDark} width={76} alt="Logo Early Beauty" loading="eager" />EARLY BEAUTY</a>
      <div class="nav-right"><div class="links"><a href="#karya">Studio</a><a href="#lash">Eyelash</a><a href="#nails">Nails</a><a href="#galeri">Galeri</a><a href="#kursus">Kursus</a></div><button type="button" class="nav-book" data-sheet>Booking</button></div>
    </nav>
    <div class="hero-frame">
      <span class="hc tl"></span><span class="hc tr"></span><span class="hc bl"></span><span class="hc br"></span>
      <svg class="spk" viewBox="0 0 24 24" style="top:-12px;left:22%;--s:22px;--d:3.4s" aria-hidden="true"><use href="#star"/></svg>
      <svg class="spk" viewBox="0 0 24 24" style="top:38%;right:7%;--s:14px;--d:4.3s" aria-hidden="true"><use href="#star"/></svg>
      <svg class="spk" viewBox="0 0 24 24" style="bottom:20%;left:8%;--s:18px;--d:5.1s" aria-hidden="true"><use href="#star"/></svg>
      <svg class="spk" viewBox="0 0 24 24" style="bottom:-10px;right:28%;--s:20px;--d:6s" aria-hidden="true"><use href="#star"/></svg>
      <div class="hf-top fade" style="animation-delay:2.9s">Eyelash · Nails · Brow</div>
      <h1><span class="l"><span>Cantik sampai ke</span></span><span class="l"><span><em class="rot" id="rot">ujung kuku.</em></span></span></h1>
      <div class="hf-rule fade" style="animation-delay:3.1s"></div>
      <div class="hf-links fade" style="animation-delay:3.2s"><a href="#nails">Hitung harga nails</a><a href="#lash">Pilih gaya bulu mata</a></div>
    </div>
  </div>
  <div class="ribbon" aria-hidden="true"><div class="track">{[...RIBBON, ...RIBBON].map(t => <span>{t}</span>)}</div></div>
</header>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><symbol id="star" viewBox="0 0 24 24"><path d="M12 0C13 8 16 11 24 12C16 13 13 16 12 24C11 16 8 13 0 12C8 11 11 8 12 0Z"/></symbol></svg>

<style is:global>
  /* intro: the logo opens from the middle, then a gold shine passes over it */
  #intro { position: fixed; inset: 0; z-index: 50; background: var(--plum); display: grid; place-items: center; animation: introOut .7s ease 2.3s forwards; }
  #intro .mark { width: min(56vw, 300px); aspect-ratio: 1; position: relative; overflow: hidden; }
  #intro img { width: 100%; height: 100%; object-fit: cover; mix-blend-mode: lighten; clip-path: inset(50% 50% 50% 50%); animation: reveal 1.3s cubic-bezier(.7,0,.2,1) .15s forwards; }
  #intro .mark::after { content: ""; position: absolute; inset: 0; background: linear-gradient(110deg, transparent 35%, rgba(227,200,143,.55) 50%, transparent 65%); transform: translateX(-120%); animation: shine 1.1s ease 1.3s forwards; mix-blend-mode: screen; }
  @keyframes reveal { to { clip-path: inset(0 0 0 0); } }
  @keyframes shine { to { transform: translateX(120%); } }
  @keyframes introOut { to { opacity: 0; visibility: hidden; transform: scale(1.04); } }

  .hero { position: relative; background: var(--plum); color: #f4e9e6; overflow: hidden; isolation: isolate; }
  .hero canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .hero .ghost { position: absolute; right: -12%; top: 6%; width: min(80vw, 620px); height: auto; opacity: .09; mix-blend-mode: lighten; z-index: -1; filter: blur(.3px); }
  .hero .glow { position: absolute; inset: auto -20% -30% -20%; height: 70%; background: radial-gradient(50% 60% at 50% 100%, rgba(138,93,86,.55), transparent 70%); z-index: -1; }
  .nav { display: flex; justify-content: space-between; align-items: center; padding-block: 16px; padding-top: max(16px, env(safe-area-inset-top, 0px)); }
  .nav .brand { display: flex; align-items: center; gap: 10px; font: 13px var(--f-display); letter-spacing: .32em; text-decoration: none; }
  .nav .brand img { width: 38px; height: 38px; mix-blend-mode: lighten; }
  .nav .links { display: flex; gap: 22px; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; }
  .nav .links a { text-decoration: none; opacity: .8; }
  .nav .links a:hover { opacity: 1; color: var(--gold-2); }
  .nav-right { display: flex; align-items: center; gap: 26px; }
  .nav-book { border: 1px solid rgba(201,164,95,.6); background: none; padding: 9px 16px; font: 500 11px var(--f-body); letter-spacing: .22em; text-transform: uppercase; color: var(--gold-2); transition: background .3s, color .3s; }
  .nav-book:hover { background: var(--gold); color: var(--plum); }

  /* the logo's square frame opens up and becomes the hero */
  .hero-frame { position: relative; margin-block: 5vh 56px; padding: clamp(56px, 10vw, 110px) clamp(18px, 5vw, 64px); display: grid; justify-items: center; gap: 26px; text-align: center;
    border: 1px solid rgba(201,164,95,.55); outline: 1px solid rgba(201,164,95,.22); outline-offset: -10px;
    animation: frameIn 1.2s cubic-bezier(.7,0,.2,1) 2.1s both; }
  @keyframes frameIn { from { clip-path: inset(50% 50% 50% 50%); } to { clip-path: inset(-20px); } }
  .hc { position: absolute; width: 38px; height: 38px; border: 2px solid var(--gold); }
  .hc::after { content: ""; position: absolute; width: 7px; height: 7px; background: var(--gold-2); transform: rotate(45deg); }
  .tl { top: -2px; left: -2px; border-right: 0; border-bottom: 0; } .tl::after { top: 8px; left: 8px; }
  .tr { top: -2px; right: -2px; border-left: 0; border-bottom: 0; } .tr::after { top: 8px; right: 8px; }
  .bl { bottom: -2px; left: -2px; border-right: 0; border-top: 0; } .bl::after { bottom: 8px; left: 8px; }
  .br { bottom: -2px; right: -2px; border-left: 0; border-top: 0; } .br::after { bottom: 8px; right: 8px; }
  .hf-top { font: 400 13px var(--f-display); letter-spacing: .5em; text-transform: uppercase; color: var(--gold-2); padding-left: .5em; }
  .hf-rule { width: 90px; height: 1px; background: linear-gradient(90deg, transparent, var(--gold), transparent); }
  .hf-links { display: flex; gap: 14px 34px; flex-wrap: wrap; justify-content: center; }
  .hf-links a { font: 500 12px var(--f-body); letter-spacing: .24em; text-transform: uppercase; text-decoration: none; padding-bottom: 8px; color: #f4e9e6;
    background: linear-gradient(var(--gold), var(--gold)) center bottom / 28% 1px no-repeat; transition: background-size .45s ease, color .3s; }
  .hf-links a:hover { background-size: 100% 1px; color: var(--gold-2); }

  .hero h1 { margin: 0; font: 400 clamp(34px, 7.4vw, 76px)/1 var(--f-display); letter-spacing: .02em; text-wrap: balance; }
  .hero h1 .l { display: block; }
  /* line 1: letters rise out of a blur, one after another */
  .ch { display: inline-block; white-space: pre; opacity: 0; filter: blur(12px); transform: translateY(.35em); animation: chIn .8s var(--ease) forwards; }
  @keyframes chIn { to { opacity: 1; filter: blur(0); transform: none; } }
  /* line 2: the italic is written in from left to right, then rewritten every few seconds */
  .hero h1 .l:nth-child(2) > span { display: inline-block; animation: wipe 1.1s var(--ease) 3.05s both; }
  @keyframes wipe { from { clip-path: inset(-30% 100% -30% 0); } to { clip-path: inset(-30% -6% -30% 0); } }
  .hero h1 em { font: italic 400 1.62em/1.05 var(--f-accent); color: var(--gold-2); }
  .rot { display: inline-block; clip-path: inset(-30% -6% -30% 0); transition: clip-path .6s var(--ease); }
  .rot.out { clip-path: inset(-30% -6% -30% 100%); }
  .rot.pre { clip-path: inset(-30% 100% -30% 0); transition: none; }
  /* four-point stars that twinkle around the frame */
  .spk { position: absolute; width: var(--s, 16px); height: var(--s, 16px); fill: var(--gold-2); opacity: 0; animation: twinkle 3.4s ease-in-out infinite; animation-delay: var(--d, 0s); pointer-events: none; }
  @keyframes twinkle { 0% { transform: scale(0) rotate(-45deg); opacity: 0; } 25% { transform: scale(1) rotate(0); opacity: 1; } 50% { transform: scale(.6) rotate(20deg); opacity: .7; } 75% { transform: scale(1) rotate(45deg); opacity: 1; } 100% { transform: scale(0) rotate(90deg); opacity: 0; } }

  .ribbon { border-block: 1px solid rgba(201,164,95,.35); background: rgba(42,29,31,.85); overflow: hidden; white-space: nowrap; }
  .ribbon .track { display: inline-flex; gap: 34px; padding: 14px 0; animation: marquee 38s linear infinite; font: 15px var(--f-display); letter-spacing: .14em; color: #ead9c4; }
  .ribbon .track span::after { content: "✦"; margin-left: 34px; color: var(--gold); font-size: 11px; vertical-align: middle; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  @media (max-width: 820px) {
    .nav .links { display: none; }
    .hf-top { font-size: 11px; letter-spacing: .3em; white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ch { opacity: 1; filter: none; transform: none; }
    .ribbon .track { animation: none; } .spk { display: none; }
  }
</style>

<script>
  import { REDUCE } from "../scripts/motion.js";

  setTimeout(() => document.getElementById("intro")?.remove(), 3200);

  // line 1: split into letters for the blur-rise, keeping words unbreakable
  const line = document.querySelector(".hero h1 .l > span");
  line.setAttribute("aria-label", line.textContent);
  let ci = 0;
  line.innerHTML = line.textContent.split(" ").map(w => `<span style="white-space:nowrap" aria-hidden="true">${[...w].map(c => `<span class="ch" style="animation-delay:${(2.5 + ci++ * .045).toFixed(3)}s">${c}</span>`).join("")}</span>`).join(" ");

  // line 2: rewritten every few seconds
  const WORDS = ["ujung kuku.", "helai bulu mata.", "lengkung alis."];
  const rot = document.getElementById("rot");
  let wi = 0;
  if (!REDUCE) setTimeout(() => setInterval(() => {
    rot.classList.add("out");
    setTimeout(() => { wi = (wi + 1) % WORDS.length; rot.textContent = WORDS[wi]; rot.classList.add("pre"); rot.classList.remove("out"); void rot.offsetWidth; rot.classList.remove("pre"); }, 600);
  }, 3600), 3000);

  // gold glitter drifting behind the hero
  const c = document.getElementById("dust"), x = c.getContext("2d");
  let W = 0, H = 0, P = [];
  const size = () => {
    const r = c.getBoundingClientRect(), d = Math.min(2, devicePixelRatio || 1);
    W = c.width = r.width * d; H = c.height = r.height * d;
    P = Array.from({ length: Math.round(r.width * r.height / 8000) }, () => ({ x: Math.random() * W, y: Math.random() * H, r: (Math.random() * 1.6 + .4) * d, v: (Math.random() * .25 + .05) * d, p: Math.random() * 6.28, s: Math.random() * .03 + .01 }));
  };
  const draw = () => {
    x.clearRect(0, 0, W, H);
    for (const q of P) {
      q.p += q.s;
      if (!REDUCE) { q.y -= q.v; q.x += Math.sin(q.p) * .2; if (q.y < -5) q.y = H + 5; }
      const a = .25 + .75 * Math.abs(Math.sin(q.p));
      x.fillStyle = `rgba(227,200,143,${(a * .8).toFixed(2)})`; x.beginPath(); x.arc(q.x, q.y, q.r, 0, 6.29); x.fill();
      if (q.r > 1.6 && a > .9) { x.strokeStyle = `rgba(255,236,200,${(a - .9) * 5})`; x.lineWidth = .6; x.beginPath(); x.moveTo(q.x - q.r * 4, q.y); x.lineTo(q.x + q.r * 4, q.y); x.moveTo(q.x, q.y - q.r * 4); x.lineTo(q.x, q.y + q.r * 4); x.stroke(); }
    }
    if (!REDUCE) requestAnimationFrame(draw);
  };
  size(); addEventListener("resize", size); draw();
</script>
