---
import { langOf, tr } from "../i18n/index.js";
const T = s => tr(langOf(Astro.url), s);
---
<section class="s" id="alis">
  <div class="in brow">
    <div class="s-head rv"><span class="eyebrow">{T("Lash lift & alis")}</span><h2>{T("Bingkai wajah,")} <em>{T("tanpa ribet.")}</em></h2><p class="lead">{T("Bulu mata asli dibuat lentik tanpa extension, dan alis dirapikan sampai fluffy.")}</p></div>
    <div class="price-list rv">
      <div class="row"><span>Lash Lift</span><span>55K</span></div>
      <div class="row"><span>Lash Lift + Tint<small>{T("Lentik sekaligus lebih gelap")}</small></span><span>60K</span></div>
      <div class="row"><span>{T("Threading Alis")}</span><span>40K</span></div>
      <div class="row"><span>Brow Lamination</span><span>70K</span></div>
      <div class="row"><span>Brow Bomber</span><span>80K</span></div>
    </div>
  </div>
</section>

<style is:global>
  .brow { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
  .brow .s-head { margin: 0; }
  .price-list .row span:last-child { font: italic 500 22px/1 var(--f-accent); color: var(--mauve); white-space: nowrap; }
  @media (max-width: 820px) { .brow { grid-template-columns: minmax(0, 1fr); } }
</style>
