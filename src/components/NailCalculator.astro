---
import { BASES, ADDS, REMOVES, TIMES } from "../data/site.js";
const k = n => n / 1000 + "rb";
---
<section class="s nails" id="nails">
  <div class="in">
    <div class="s-head rv"><span class="eyebrow">Nails · harga per jari</span><h2>Pilih desainnya, <em>langsung tahu totalnya.</em></h2><p class="lead">Pilih dasar kuku dan desainnya. Nota langsung terhitung, lalu kirim ke WhatsApp untuk booking.</p></div>
    <div class="calc">
      <div class="pick">
        <div><h3>1 · Dasar kuku</h3><div class="chips" id="bases">{BASES.map((b, i) => <button type="button" data-i={i}>{b[0]}<small>{k(b[1])}</small></button>)}</div>
          <div class="fingers">Jumlah jari <span class="step"><button type="button" id="fMinus" aria-label="Kurangi jari">−</button><output id="fingers">10</output><button type="button" id="fPlus" aria-label="Tambah jari">+</button></span></div></div>
        <div><h3>2 · Desain &amp; hiasan (per jari)</h3><div class="adds" id="adds">{ADDS.map((a, i) => (
          <div class="add" id={`add${i}`}><span>{a[0]}<small>{k(a[1])} / jari</small></span><span class="step"><button type="button" data-a={i} data-d="-1" aria-label={`Kurangi ${a[0]}`}>−</button><output id={`ao${i}`}>0</output><button type="button" data-a={i} data-d="1" aria-label={`Tambah ${a[0]}`}>+</button></span></div>
        ))}</div></div>
        <div><h3>3 · Lepas kuku lama?</h3><div class="chips" id="removes">{REMOVES.map((r, i) => <button type="button" data-i={i}>{r[0]}{r[1] > 0 && <small>{k(r[1])}/jari</small>}</button>)}</div></div>
      </div>
      <div class="nota-wrap rv">
        <div class="nota" aria-live="polite">
          <div class="nh"><b>NOTA NAILS</b><span>Early Beauty Studio · estimasi</span></div>
          <div id="lines"></div>
          <div class="tot"><span>TOTAL</span><span id="total">Rp 0</span></div>
          <div class="when">
            <label for="date">Tanggal<input type="date" id="date" /></label>
            <label for="time">Jam<select id="time">{TIMES.map(t => <option>{t}</option>)}</select></label>
          </div>
          <a class="btn dark send" id="send" target="_blank" rel="noopener">Kirim nota ke WhatsApp</a>
          <div class="fine">Harga akhir dikonfirmasi studio lewat WA.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  .nails { background: var(--blush); position: relative; overflow: hidden; }
  .nails::before { content: ""; position: absolute; width: 520px; height: 520px; left: -160px; top: -200px; border-radius: 50%; background: radial-gradient(circle, rgba(201,154,145,.45), transparent 65%); }
  .calc { display: grid; grid-template-columns: 1fr minmax(0, 400px); gap: 40px; align-items: start; position: relative; }
  .pick { display: grid; gap: 26px; min-width: 0; }
  .pick h3 { font: 500 12px var(--f-body); letter-spacing: .24em; text-transform: uppercase; margin: 0 0 10px; color: var(--mauve); }
  .fingers { margin-top: 12px; display: flex; align-items: center; gap: 12px; font-size: 14px; }
  .adds { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
  .add { display: flex; justify-content: space-between; align-items: center; gap: 10px; background: rgba(255,255,255,.75); border: 1px solid #ead6d0; padding: 8px 8px 8px 14px; font-size: 14px; }
  .add.on { border-color: var(--mauve); background: #fff; }
  .add small { color: var(--muted); display: block; font-size: 12px; }
  .step { display: inline-flex; align-items: center; border: 1px solid var(--line); background: #fff; }
  .step button { width: 30px; height: 30px; border: 0; background: none; font-size: 17px; }
  .step output { min-width: 22px; text-align: center; font: 700 13px var(--f-nota); }

  /* the receipt, with a torn bottom edge */
  .nota-wrap { position: sticky; top: 20px; }
  .nota { background: #fffdfa; padding: 26px 22px 34px; font: 14px/1.5 var(--f-nota); color: #3a2420; box-shadow: 0 24px 50px -26px rgba(80,40,35,.55); transform: rotate(-1deg);
    -webkit-mask: radial-gradient(7px at 50% 100%, #0000 98%, #000) 0 0/16px 100% repeat-x; mask: radial-gradient(7px at 50% 100%, #0000 98%, #000) 0 0/16px 100% repeat-x; }
  .nota .nh { text-align: center; border-bottom: 1px dashed #c9aaa3; padding-bottom: 12px; margin-bottom: 10px; }
  .nota .nh b { display: block; letter-spacing: .2em; }
  .nota .nh span { font-size: 12px; color: #8a6d68; }
  .nota .ln { display: grid; grid-template-columns: 1fr auto; gap: 10px; padding: 5px 0; border-bottom: 1px dotted #d8bdb6; animation: pop .35s ease; }
  @keyframes pop { from { background: #f6e3dc; } to { background: transparent; } }
  .nota .ln span:last-child, .nota .tot span:last-child { font-variant-numeric: tabular-nums; }
  .nota .tot { display: flex; justify-content: space-between; font-weight: 700; font-size: 18px; margin-top: 14px; padding-top: 10px; border-top: 2px solid #3a2420; }
  .nota .when { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 16px; }
  .nota label { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #8a6d68; display: grid; gap: 4px; }
  .nota input, .nota select { font: 14px var(--f-nota); padding: 7px; border: 1px solid #d8bdb6; background: #fff; color: #3a2420; width: 100%; }
  .nota .send { margin-top: 18px; width: 100%; }
  .nota .fine { font-size: 12px; color: #8a6d68; margin-top: 10px; text-align: center; }
  @media (max-width: 820px) { .calc { grid-template-columns: minmax(0, 1fr); } .nota-wrap { position: static; } }
</style>

<script>
  import { BASES, ADDS, REMOVES, rp, waLink, longDate } from "../data/site.js";
  import { holyDays, DAY } from "../lib/bali.js";
  const $ = id => document.getElementById(id);
  // starts as an example set so the receipt is never empty
  const st = { base: 2, fingers: 10, adds: ADDS.map(a => a[0] === "Cat Eye" ? 10 : a[0] === "3D Flowers" ? 2 : 0), remove: 0 };
  $("date").value = new Date(holyDays().today + DAY).toISOString().slice(0, 10);

  let shown = 0;
  function countTo(target) {
    const from = shown, t0 = performance.now();
    const tick = now => { const p = Math.min(1, (now - t0) / 350); shown = Math.round(from + (target - from) * p); $("total").textContent = rp(shown); if (p < 1) requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
  }

  function render() {
    const f = st.fingers, lines = [];
    lines.push([`${BASES[st.base][0]} ${BASES[st.base][1] / 1000}rb × ${f}`, BASES[st.base][1] * f]);
    st.adds.forEach((c, i) => { if (c) lines.push([`${ADDS[i][0]} ${ADDS[i][1] / 1000}rb × ${c}`, ADDS[i][1] * c]); });
    if (st.remove) lines.push([`Remove ${REMOVES[st.remove][0]} × ${f}`, REMOVES[st.remove][1] * f]);
    const total = lines.reduce((s, l) => s + l[1], 0);
    $("lines").innerHTML = lines.map(l => `<div class="ln"><span>${l[0]}</span><span>${l[1].toLocaleString("id-ID")}</span></div>`).join("");
    $("fingers").textContent = f;
    $("bases").querySelectorAll("button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.i == st.base)));
    $("removes").querySelectorAll("button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.i == st.remove)));
    st.adds.forEach((c, i) => { $("ao" + i).textContent = c; $("add" + i).classList.toggle("on", c > 0); });
    countTo(total);
    const d = $("date").value ? longDate(Date.parse($("date").value + "T00:00:00Z")) : "-";
    $("send").href = waLink(`Halo kak Early Beauty, saya mau booking nails:\n${lines.map(l => "- " + l[0] + " = " + l[1].toLocaleString("id-ID")).join("\n")}\nEstimasi total: ${rp(total)}\nTanggal: ${d}\nJam: ${$("time").value} WITA\nApakah slotnya masih ada?`);
  }

  $("bases").addEventListener("click", e => { const b = e.target.closest("button"); if (b) { st.base = +b.dataset.i; render(); } });
  $("removes").addEventListener("click", e => { const b = e.target.closest("button"); if (b) { st.remove = +b.dataset.i; render(); } });
  $("adds").addEventListener("click", e => { const b = e.target.closest("button[data-a]"); if (!b) return; const i = +b.dataset.a; st.adds[i] = Math.max(0, Math.min(10, st.adds[i] + +b.dataset.d)); render(); });
  $("fMinus").onclick = () => { st.fingers = Math.max(1, st.fingers - 1); render(); };
  $("fPlus").onclick = () => { st.fingers = Math.min(10, st.fingers + 1); render(); };
  $("date").onchange = $("time").onchange = render;

  render();
</script>
