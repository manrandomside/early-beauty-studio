---
import { Image } from "astro:assets";
import { WORKS } from "../data/site.js";
import { photo } from "../data/photos.js";
---
<section class="works" id="karya">
  <div class="works-pin" id="worksPin">
    <div class="works-sticky">
      <div class="in"><div class="s-head rv" style="margin-bottom:30px"><span class="eyebrow">Early Beauty Studio · Banyubiru, Negara</span><h2>Masuk dulu, <em>lihat-lihat sebentar.</em></h2></div></div>
      <div class="works-track" id="worksTrack">
        {WORKS.map(([label, key]) => (
          <figure class="work"><div class="img"><Image src={photo(key)} widths={[360, 660]} sizes="330px" alt={`${label} di Early Beauty Studio`} /></div><figcaption>{label}</figcaption></figure>
        ))}
      </div>
      <div class="in"><div class="works-bar"><i id="worksBar"></i></div></div>
    </div>
  </div>
</section>

<style is:global>
  /* dark showcase of the studio: pinned horizontal scroll on every screen */
  .works { background: var(--plum); color: #f1e4e0; padding-block: 84px; }
  .works .s-head .eyebrow { color: var(--gold-2); }
  .works h2 em { color: var(--gold-2); }
  .works-track { display: flex; gap: 22px; padding-inline: max(18px, calc((100vw - 1120px) / 2 + 18px)); will-change: transform; }
  .work { flex: 0 0 auto; width: min(72vw, 330px); margin: 0; display: grid; gap: 12px; }
  .work .img { aspect-ratio: 4/5; max-width: 100%; overflow: hidden; position: relative; }
  .work .img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transform: scale(var(--z, 1)); transition: transform .1s linear; }
  .work figcaption { font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: var(--gold-2); }
  .works-bar { height: 1px; background: rgba(255,255,255,.12); margin-top: 30px; position: relative; }
  .works-bar i { position: absolute; left: 0; top: -1px; height: 3px; width: 0; background: var(--gold); }
  /* the section holds the screen while the photos slide sideways */
  @media (prefers-reduced-motion: no-preference) {
    .works { padding-block: 0; }
    .works-pin { height: 280vh; }
    .works-sticky { position: sticky; top: 0; height: 100svh; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
    .work { width: min(330px, calc((100svh - 300px) * .8)); }
  }
  /* phones: a shorter hold so a quick thumb scroll never feels stuck */
  @media (max-width: 820px) and (prefers-reduced-motion: no-preference) {
    .works-pin { height: 240vh; }
    .work { width: min(62vw, calc((100svh - 260px) * .8)); }
  }
  /* reduced motion: a plain swipe carousel */
  @media (prefers-reduced-motion: reduce) {
    .works-track { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 6px; }
    .works-track::-webkit-scrollbar { display: none; }
    .work { scroll-snap-align: center; }
  }
</style>

<script>
  const track = document.getElementById("worksTrack"), pin = document.getElementById("worksPin"), bar = document.getElementById("worksBar");
  const pinned = matchMedia("(prefers-reduced-motion: no-preference)");
  function update() {
    if (!pinned.matches) {
      track.style.transform = ""; track.style.removeProperty("--z");
      const max = track.scrollWidth - track.clientWidth;
      bar.style.width = (max > 0 ? track.scrollLeft / max * 100 : 0) + "%";
      return;
    }
    const r = pin.getBoundingClientRect(), p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
    track.style.transform = `translate3d(${-p * (track.scrollWidth - innerWidth)}px,0,0)`;
    track.style.setProperty("--z", (1.12 - .12 * p).toFixed(3));
    bar.style.width = (p * 100).toFixed(1) + "%";
  }
  let queued = false;
  const queue = () => { if (!queued) { queued = true; requestAnimationFrame(() => { queued = false; update(); }); } };
  addEventListener("scroll", queue, { passive: true }); addEventListener("resize", queue); track.addEventListener("scroll", queue, { passive: true });
  update();
</script>
