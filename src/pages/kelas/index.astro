---
import { langOf, tr } from "../../i18n/index.js";
const T = s => tr(langOf(Astro.url), s);
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Courses from "../../components/Courses.astro";
import Footer from "../../components/Footer.astro";
import Booking from "../../components/Booking.astro";
---
<Base path="/kelas/" title="Kelas nail art & eyelash · Early Beauty Studio Negara" description="Kursus nail art, eyelash extension dan lash lift di Early Beauty Studio, Negara. Pilih paket ilmu saja atau ilmu + alat, lalu daftar lewat WhatsApp.">
  <PageHead eyebrow={T("Kelas kecantikan")} title={T("Belajar langsung")} accent={T("di studio.")} lead={T("Kelas kecil, praktek langsung, dan pilihan paket dengan alat yang bisa dibawa pulang.")} />
  <main>
    <Courses />
  </main>
  <Footer />
  <Booking />
</Base>
