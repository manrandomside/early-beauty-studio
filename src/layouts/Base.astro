---
import { Font } from "astro:assets";
import "../styles/global.css";
import Announce from "../components/Announce.astro";
import { ADDRESS, WA, IG } from "../data/site.js";

// each page passes its own title, description and path; the home page uses the defaults
const {
  title = "Early Beauty Studio · Eyelash, Nails & Alis di Negara, Jembrana",
  description = "Studio eyelash extension, nail art, lash lift dan alis di Banyubiru, Negara, Jembrana. Cek harga, hitung harga nails, lalu booking lewat WhatsApp. Buka setiap hari 10.00–17.00 WITA.",
  path = "/",
  admin = false // the admin page is kept out of search and shows no announcement bar
} = Astro.props;
const url = new URL(path, Astro.site);

// tells Google this is a local beauty salon, with hours and location
const business = {
  "@context": "https://schema.org",
  "@type": "BeautySalon",
  name: "Early Beauty Studio",
  telephone: "+" + WA,
  address: { "@type": "PostalAddress", streetAddress: ADDRESS, addressLocality: "Negara", addressRegion: "Bali", postalCode: "82212", addressCountry: "ID" },
  geo: { "@type": "GeoCoordinates", latitude: -8.3509707, longitude: 114.5964022 },
  openingHours: "Mo-Su 10:00-17:00",
  sameAs: [IG]
};
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <!-- link preview when the site is shared on WhatsApp, Instagram or Facebook -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="Early Beauty Studio" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo Early Beauty Studio dengan foto hasil nails dan eyelash" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1d1416" />
    {admin && <meta name="robots" content="noindex, nofollow" />}
    <meta name="google-site-verification" content="GrRMnakamGSIoDjnY9ZcmH60ai_EUyunxHmEFPh6SGE" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- the three faces seen in the first screen are preloaded; the receipt font loads when needed -->
    <Font cssVariable="--font-marcellus" preload />
    <Font cssVariable="--font-cormorant" preload={[{ weight: 400, style: "italic" }]} />
    <Font cssVariable="--font-jost" preload={[{ weight: 500 }]} />
    <Font cssVariable="--font-courier" />
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    <!-- set before first paint so reveal-on-scroll never flashes visible content -->
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    {!admin && <Announce />}
    <slot />
    <script>
      import { initReveal, initSmoothScroll } from "../scripts/motion.js";
      initReveal();
      initSmoothScroll();
    </script>
  </body>
</html>
